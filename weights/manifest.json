{
  "version": "0.1.0",
  "license": "MIT",
  "note": "Package code is MIT. Converted YOLOv9 tensors stay AGPL-3.0 (see docs/licenses.md). Checkpoints are GitHub Release assets, not git. Fill mAP with: coreyolo val --data datasets/coco/data.yaml --weights <file> --json weights/metrics-<id>.json --zoo-id <id>",
  "models": [
    {
      "id": "coreyolo-n-coco",
      "family": "gelan",
      "scale": "n",
      "task": "detect",
      "act": "silu",
      "imgsz": 640,
      "nc": 80,
      "how": "coreyolo convert --weights yolov9t.pt --out weights/coreyolo-n-coco.coreyolo",
      "weights_origin": "ultralytics-yolov9",
      "weights_license": "AGPL-3.0",
      "files": {
        "checkpoint": "coreyolo-n-coco.coreyolo",
        "coreml": "coreyolo-n-coco.mlpackage"
      },
      "metrics": {
        "dataset": "COCO 2017 val",
        "mAP50": null,
        "mAP50-95": null
      }
    },
    {
      "id": "coreyolo-l-coco",
      "family": "gelan",
      "scale": "l",
      "task": "detect",
      "act": "silu",
      "imgsz": 640,
      "nc": 80,
      "how": "coreyolo convert --weights yolov9c.pt --out weights/coreyolo-l-coco.coreyolo",
