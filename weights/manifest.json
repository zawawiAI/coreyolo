      "imgsz": 640,
      "nc": 80,
      "how": "coreyolo train --data datasets/coco/data.yaml --model n --task segment --family gelan",
      "weights_origin": "coreyolo-train",
      "weights_license": "MIT",
      "files": {
        "checkpoint": "coreyolo-n-coco-seg.coreyolo",
        "coreml": "coreyolo-n-coco-seg.mlpackage"
      },
      "metrics": {
        "dataset": "COCO 2017 val (box mAP until mask val lands)",
        "mAP50": null,
        "mAP50-95": null
      }
    },
    {
      "id": "coreyolo-n-coco-relu",
